    {
      "parameters": {
        "jsCode": "// Normalize multi-channel inputs into a unified lead payload\nconst item = $input.first().json;\n\nlet channel = 'web';\nlet sender_id = 'default_user';\nlet sender_name = 'Unknown';\nlet phone = 'Not Specified';\nlet message = '';\n\nif (item.message && item.message.chat) {\n  // 1. TELEGRAM\n  channel = 'telegram';\n  sender_id = item.message.chat.id.toString();\n  const first = item.message.from?.first_name || '';\n  const last = item.message.from?.last_name || '';\n  sender_name = `${first} ${last}`.trim() || item.message.from?.username || 'Telegram User';\n  phone = 'Telegram ID: ' + sender_id;\n  message = item.message.text || '';\n} else if (item.entry && item.entry[0]?.changes && item.entry[0]?.changes[0]?.value?.messages) {\n  // 2. WHATSAPP CLOUD API\n  channel = 'whatsapp';\n  const waMsg = item.entry[0].changes[0].value.messages[0];\n  const waContact = item.entry[0].changes[0].value.contacts?.[0];\n  sender_id = waMsg.from;\n  phone = '+' + waMsg.from;\n  sender_name = waContact?.profile?.name || 'WhatsApp Customer';\n  message = waMsg.text?.body || '';\n} else if (item.entry && item.entry[0]?.messaging) {\n  // 3. INSTAGRAM DIRECT MESSAGE\n  channel = 'instagram';\n  const igMsg = item.entry[0].messaging[0];\n  sender_id = igMsg.sender?.id || 'ig_user';\n  sender_name = 'Instagram Follower';\n  phone = 'IG Sender ID: ' + sender_id;\n  message = igMsg.message?.text || '';\n} else {\n  // 4. WEB CHAT / WEBHOOK\n  channel = 'web';\n  sender_id = item.body?.sender_id || item.sender_id || 'web_' + Math.random().toString(36).substring(7);\n  sender_name = item.body?.sender_name || item.sender_name || 'Web Visitor';\n  phone = item.body?.phone || item.phone || 'Not Specified';\n  message = item.body?.message || item.message || '';\n}\n\nreturn {\n  json: {\n    channel,\n    sender_id,\n    sender_name,\n    phone,\n    message\n  }\n};"
      },
      "id": "node_normalizer",
      "name": "Channel Normalizer (Router Entry)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        420
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Channel: {{ $json.channel }}\nCustomer Name: {{ $json.sender_name }}\nContact Info: {{ $json.phone }}\nCustomer Message: {{ $json.message }}",
        "options": {
          "systemMessage": "=You are an expert \"Lead Qualification & Sales Assistant\" for a high-growth B2B & B2C enterprise services company.\n\nYOUR OBJECTIVE:\n1. Analyze the customer's latest incoming message along with conversational history stored in memory.\n2. Evaluate their budget status, timeframe/urgency, and purchase intent (seriousness).\n3. Draft a polite, persuasive, and consultative response.\n4. Output STRICTLY and ONLY in the specified JSON format. Do NOT wrap in extra conversational filler outside JSON.\n\nQUALIFICATION CRITERIA (is_lead_ready = true):\n- The client states a clear need or project scope (e.g. mobile app, e-commerce, custom AI, CRM).\n- Mentions a budget range or is open to receiving an official proposal/quote.\n- Has an actionable timeframe (e.g. urgent, this month, Q1/Q2).\n- If the customer is merely asking exploratory questions without scope or contact details, set is_lead_ready: false and politely prompt for missing details (budget, timeline, contact info) in reply_message.\n\nREQUIRED JSON SCHEMA:\n{\n  \"customer_name\": \"Detected name or 'Unknown'\",\n  \"contact_info\": \"Phone or email extracted (or 'None')\",\n  \"service_requested\": \"Summary of service or project requested\",\n  \"budget_status\": \"Low / Medium / High / Not Specified\",\n  \"timeframe\": \"Immediate / 1 Month / 1-3 Months / Exploratory\",\n  \"lead_score\": 85,\n  \"is_lead_ready\": true,\n  \"summary\": \"1-sentence executive summary note for the sales team\",\n  \"reply_message\": \"Professional, engaging response sent back to the customer\"\n}"
        }
      },
      "id": "node_ai_agent",
      "name": "AI Agent (Central Brain)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        620,
        420
      ]
    },
    {
      "parameters": {
        "model": "llama3.2:3b",
        "options": {
          "temperature": 0.2
