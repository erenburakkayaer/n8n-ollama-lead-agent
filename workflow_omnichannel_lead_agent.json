    {
      "parameters": {
        "jsCode": "// Sanitize LLM output and parse JSON\nlet rawResponse = $input.first().json.output || $input.first().json.text || $input.first().json.response || '';\nrawResponse = rawResponse.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nconst norm = $('Channel Normalizer (Router Entry)').first().json;\n\nlet parsedData = {};\ntry {\n  parsedData = JSON.parse(rawResponse);\n} catch (error) {\n  parsedData = {\n    customer_name: norm.sender_name || 'Unknown',\n    contact_info: norm.phone || norm.sender_id || 'None',\n    service_requested: 'General Inquiry',\n    budget_status: 'Not Specified',\n    timeframe: 'Exploratory',\n    lead_score: 25,\n    is_lead_ready: false,\n    summary: 'Model output could not be parsed as JSON',\n    reply_message: rawResponse || 'Thank you for contacting us. A project manager will review your request.'\n  };\n}\n\n// Attach routing metadata\nparsedData.channel = norm.channel;\nparsedData.sender_id = norm.sender_id;\nparsedData.sender_name = norm.sender_name;\nparsedData.phone = norm.phone;\n\nreturn { json: parsedData };"
      },
      "id": "node_parser",
      "name": "JSON Parser & Sanitizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        420
      ]
    },
