# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
N8N_SECURE_COOKIE=false
N8N_CORS_ALLOWED_ORIGINS=*

# Cloudflare Tunnel Token (Optional: for exposing webhooks publicly with free HTTPS)
# CLOUDFLARE_TUNNEL_TOKEN=

# Telegram Bot Token (Optional: from @BotFather)
# TELEGRAM_BOT_TOKEN=

# Meta WhatsApp Cloud API & Instagram Graph API (Optional)
# META_GRAPH_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
