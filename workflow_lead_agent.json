        },
        "options": {}
      },
      "id": "node_google_sheets",
      "name": "Google Sheets (Append Hot Lead)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1480,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"is_lead_ready\": true,\n  \"reply_message\": {{ JSON.stringify($('JSON Parser & Sanitizer').item.json.reply_message) }},\n  \"lead_score\": {{ $('JSON Parser & Sanitizer').item.json.lead_score || 0 }},\n  \"summary\": {{ JSON.stringify($('JSON Parser & Sanitizer').item.json.summary || '') }}\n}",
        "options": {
          "responseCode": 200
        }
      },
