        "responseBody": "={\n  \"status\": \"info_needed\",\n  \"is_lead_ready\": false,\n  \"reply_message\": {{ JSON.stringify($('JSON Parser & Sanitizer').item.json.reply_message) }},\n  \"lead_score\": {{ $('JSON Parser & Sanitizer').item.json.lead_score || 0 }}\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node_reply_followup",
      "name": "Respond to Webhook (Follow-Up)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1720,
        500
      ]
    }
